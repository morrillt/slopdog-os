{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeskStandingContext",
  "description": "Schema for desk-standing-context.json mapping lanes and profiles to context blocks",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_-]+$": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "read": { "type": "string" },
                  "text": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
