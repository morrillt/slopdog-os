<!--
  PRODUCT REQUIREMENTS DOCUMENT (PRD) — TEMPLATE (FULL)

  Purpose:
  This document defines WHAT is being built and WHY, at a level precise enough
  to deterministically generate engineering tickets, test cases, and architecture decisions.

  Intended lifecycle:
  Draft → Review → Approved → Ticket generation → Build

  Design principle:
  Every section exists to reduce ambiguity before work begins.
-->

<PRDTemplate version="1.1" size="full">

  <!-- ========================= -->
  <!-- Meta: Ownership & Context -->
  <!-- ========================= -->
  <!--
    Why this section matters:
    Establishes accountability, scope ownership, and document freshness.
    Prevents ambiguity about who decides and who is impacted.
  -->
  <Meta>
    <Title>[PRD Title]</Title>
    <ProductArea>[e.g., Guest Booking / Host Supply]</ProductArea>
    <Owner>[Name]</Owner>
    <Stakeholders>
      <Stakeholder role="[PM/Eng/Design/Data/Legal]" name="[Name]" />
    </Stakeholders>
    <Status>[Draft|Review|Approved]</Status>
    <LastUpdated>[YYYY-MM-DD]</LastUpdated>
  </Meta>

  <!-- =============================== -->
  <!-- 1. High-Level Description -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Aligns everyone on the problem, solution, and outcome before details.
    If this is unclear, everything downstream will be misaligned.
  -->
  <Section id="1" name="High-Level Description">
    <IntroParagraph>
      [Problem → solution → outcome in one concise paragraph.]
    </IntroParagraph>
    <SupportingBullets>
      <Bullet>[Primary user persona(s)]</Bullet>
      <Bullet>[Core user journey impacted]</Bullet>
      <Bullet>[Business value / KPI movement]</Bullet>
      <Bullet>[Explicit out-of-scope item]</Bullet>
      <Bullet>[Constraints: time/legal/platform]</Bullet>
    </SupportingBullets>
  </Section>

  <!-- =============================== -->
  <!-- 2. Goals and Non-Goals -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Forces clarity on success and prevents scope creep.
    Non-goals are as important as goals.
  -->
  <Section id="2" name="Goals and Non-Goals">
    <Goals>
      <Goal>[Measurable outcome #1]</Goal>
      <Goal>[Measurable outcome #2]</Goal>
      <Goal>[Measurable outcome #3]</Goal>
    </Goals>
    <NonGoals>
      <NonGoal>[Explicit exclusion #1]</NonGoal>
      <NonGoal>[Explicit exclusion #2]</NonGoal>
      <NonGoal>[Explicit exclusion #3]</NonGoal>
    </NonGoals>
  </Section>

  <!-- =============================== -->
  <!-- 3. Functional Requirements -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    This is the contract between product and engineering.
    It is the primary source for ticket creation and testing.
  -->
  <Section id="3" name="Functional Requirements">
    <FunctionalRequirementsTable>
      <Row>
        <ID>FR-1</ID>
        <UserStory>As a [user type], I want to [action], so that [outcome].</UserStory>
        <AcceptanceCriteria>
          <Criterion>Given [state], when [action], then [result].</Criterion>
          <Criterion>[Binary pass/fail]</Criterion>
        </AcceptanceCriteria>
        <EdgeCases>
          <EdgeCase>[Failure mode]</EdgeCase>
        </EdgeCases>
        <Priority>P0</Priority>
      </Row>
    </FunctionalRequirementsTable>
  </Section>

  <!-- =============================== -->
  <!-- 4. User Flows -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Provides narrative context for user stories.
    Ensures requirements map to real user behavior, not isolated features.
  -->
  <Section id="4" name="User Flows">
    <UserFlow id="UF-1">
      <Name>[Flow name]</Name>
      <Goal>[User completes X]</Goal>
      <PrimaryUser>[Persona]</PrimaryUser>
      <EntryPoints>
        <EntryPoint>[Homepage]</EntryPoint>
      </EntryPoints>
      <Steps>
        <Step index="1">[Step]</Step>
        <Step index="2">[Step]</Step>
      </Steps>
      <DecisionPoints />
      <ExitStates />
      <EdgeCases />
    </UserFlow>
  </Section>

  <!-- =============================== -->
  <!-- 5. Architecture and Tech Options -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Surfaces tradeoffs early without locking implementation.
    Prevents late-stage architectural surprises.
  -->
  <Section id="5" name="Architecture and Tech Options">
    <SystemComponents>
      <Component>
        <Name>Frontend</Name>
        <Option name="OptionA">[Next.js]</Option>
        <Option name="OptionB">[React SPA]</Option>
        <Tradeoffs>[SEO vs simplicity]</Tradeoffs>
      </Component>
    </SystemComponents>
  </Section>

  <!-- =============================== -->
  <!-- 6. Metrics and Instrumentation -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Defines how success is measured.
    Prevents shipping features with no feedback loop.
  -->
  <Section id="6" name="Metrics and Instrumentation">
    <Metrics>
      <Metric>
        <Name>[Metric]</Name>
        <Definition>[Exact definition]</Definition>
        <SuccessThreshold>[Target]</SuccessThreshold>
        <WhereMeasured>[Client/Server]</WhereMeasured>
      </Metric>
    </Metrics>
  </Section>

  <!-- =============================== -->
  <!-- 7. Risks, Dependencies, Open Questions -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Makes uncertainty explicit.
    Prevents teams from discovering blockers mid-build.
  -->
  <Section id="7" name="Risks Dependencies and Open Questions">
    <Risks>
      <Risk>[Risk]</Risk>
    </Risks>
    <Dependencies>
      <Dependency>[Dependency]</Dependency>
    </Dependencies>
    <OpenQuestions>
      <Question>[Decision needed]</Question>
    </OpenQuestions>
  </Section>

  <!-- =============================== -->
  <!-- Next Step: Ticket Generation -->
  <!-- =============================== -->
  <!--
    Why this section matters:
    Defines the handoff contract from PRD to execution.
    Enables automated or deterministic ticket creation.
  -->
  <NextStep name="Ticket Generation">
    <TicketingRules>
      <Rule>One ticket per FR row.</Rule>
      <Rule>Sub-tasks from edge cases.</Rule>
      <Rule>Tests from acceptance criteria.</Rule>
      <Rule>Group by user flow.</Rule>
    </TicketingRules>
  </NextStep>

</PRDTemplate>

